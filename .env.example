# CO-OP OS Environment Variable Configuration

# ------------------------------------
# SUPABASE POSTGRESQL DATABASE CONFIG
# ------------------------------------
# Obtain your Supabase URL and keys from https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL=https://your-supabase-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ------------------------------------
# AUTHENTICATION & SECURITY CONFIG
# ------------------------------------
JWT_SECRET=your-secure-production-jwt-secret-key-change-this
FRONTEND_URL=http://localhost:5173

# ------------------------------------
# BACKEND EXPRESS SERVER CONFIG
# ------------------------------------
PORT=5000
NODE_ENV=production

# ------------------------------------
# FRONTEND VITE CLIENT CONFIG
# ------------------------------------
# Leave empty for relative URL when deployed on Vercel or specify http://localhost:5000/api
VITE_API_BASE_URL=
